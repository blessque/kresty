node_modules/
dist/
.DS_Store
*.local
CLAUDE.md
memory/
.claude/
*.tsbuildinfo

# mood-board / raw source material — archive only, never served or built
/references/

# client photo drops — the source PNGs the public/resources/*.webp are baked from
/new-photos/
/new_photos/

# scripts/interact-test.mjs writes its screenshots to $OUT, defaulting to the
# repo root — keep the runs out of git
/hover-koncept.png
/switched-*.png
/transition-mid.png
/after-transition.png
/map-tilt-*.png
/back-on-main.png
# ...and when a one-off script interpolates an UNSET $OUT, JS stringifies it and
# `page.screenshot` creates a literal `undefined/` directory. Harmless, but it
# shows up as an untracked folder every time.
/undefined/
tokens.zip

# `npm run spec:figma` writes the measured build here (default `.figma-spec`,
# and `--out` is how you keep a before/after pair to diff). It is a MEASUREMENT
# of the code, not a source of it — regenerate rather than commit.
/.figma-spec*/
